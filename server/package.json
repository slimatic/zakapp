{
  "name": "zakapp-server",
  "version": "1.1.4",
  "description": "zakapp backend server",
  "scripts": {
    "build": "tsc && node -e \"require('fs').existsSync('dist/server/src/app.js')||(console.error('BUILD BROKEN: dist/server/src/app.js was not emitted; rootDir must stay pinned to .. in server/tsconfig.json, since npm start runs that path'),process.exit(1))\"",
    "start": "node dist/server/src/app.js",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/app.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:deps": "node scripts/check-declared-deps.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:dev": "ts-node --transpile-only scripts/seed-dev-data.ts",
    "db:backup": "ts-node --transpile-only scripts/backup-database.ts"
  },
  "main": "dist/server/src/app.js",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/compression": "^1.8.1",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^8.0.2",
    "@zakapp/shared": "file:../shared",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.1.1",
    "helmet": "^8.3.0",
    "hijri-converter": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-hijri": "^3.0.0",
    "morgan": "^1.12.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.3.1",
    "prisma": "^7.10.1",
    "proxy-addr": "^2.0.8",
    "redis": "^6.3.1",
    "resend": "^6.4.2",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^14.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@swc/core": "1.15.11",
    "@types/bcryptjs": "^3.0.0",
    "@types/cheerio": "^1.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/moment-hijri": "^2.1.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.2",
    "@types/node-cron": "^3.0.11",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^31.0.0",
    "nodemon": "^3.1.4",
    "playwright-core": "1.64.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "uuid": "^14.0.0",
    "qs": "^6.16.0",
    "undici": "^7.29.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
