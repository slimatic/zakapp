{
  "name": "client",
  "version": "1.3.2",
  "private": true,
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^7.0.8",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-devtools": "^5.108.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/user-event": "14.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@zakapp/shared": "file:../shared",
    "ajv": "^8.17.1",
    "axios": "^1.21.1",
    "brace-expansion": "^5.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.7",
    "dompurify": "3.4.18",
    "framer-motion": "^14.14.0",
    "hijri-converter": "^1.1.1",
    "i18next": "^27.2.4",
    "i18next-browser-languagedetector": "^8.3.1",
    "js-sha256": "^1.1.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "react-window": "^2.5.4",
    "react-window-infinite-loader": "^2.0.2",
    "recharts": "^3.11.0",
    "rxdb": "^17.6.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "uuid": "^14.0.3",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite preview --host --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lhci autorun",
    "lighthouse:ci": "lhci autorun --config=lighthouserc.json",
    "lighthouse:desktop": "lighthouse http://localhost:3000 --preset=desktop --view",
    "lighthouse:mobile": "lighthouse http://localhost:3000 --preset=mobile --view",
    "lighthouse:pwa": "lighthouse http://localhost:3000 --only-categories=pwa --view",
    "verify:source": "python3 scripts/run-source-checks.py",
    "verify:browser": "python3 scripts/run-browser-checks.py",
    "verify:ui": "npm run verify:source && npm run verify:browser",
    "inject:config": "python3 scripts/inject-app-config.py",
    "build:local": "npm run build && npm run inject:config"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@axe-core/react": "^4.14.0",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/axe-core": "^3.0.6",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.11.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "rollup-plugin-visualizer": "^7.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@pages/(.*)$": "<rootDir>/src/pages/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@contexts/(.*)$": "<rootDir>/src/contexts/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@types/(.*)$": "<rootDir>/src/types/$1",
      "^@data/(.*)$": "<rootDir>/src/data/$1",
      "^@zakapp/shared$": "<rootDir>/../shared/src/index.ts",
      "^@zakapp/shared/(.*)$": "<rootDir>/../shared/src/$1",
      "^(.*)\\.js$": "$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!zod)"
    ]
  },
  "overrides": {
    "protobufjs": "8.6.6",
    "websocket-driver": "0.7.5",
    "rxdb": {
      "ws": "^8.21.3",
      "ajv": "^8.20.0"
    },
    "postcss-selector-parser": "^6.1.5",
    "minimatch": "^11.0.1"
  },
  "license": "AGPL-3.0-or-later"
}
