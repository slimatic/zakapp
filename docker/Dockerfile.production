# Multi-stage production Dockerfile

# Base stage for package definitions
FROM node:20-slim AS base
WORKDIR /app
ARG GIT_COMMIT_HASH
ENV GIT_COMMIT_HASH=$GIT_COMMIT_HASH
ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

# Copy package files
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY server/package*.json ./server/
COPY client/package*.json ./client/

# ----------------------------------------
# Client Build Stage
# Runs on the BUILDPLATFORM (e.g., amd64) to ensure fast Vite builds
# even when targeting arm64.
# ----------------------------------------
FROM --platform=$BUILDPLATFORM node:20-slim AS client-builder
WORKDIR /app
# Re-declare ARG and ENV as they don't persist across stages automatically
ARG GIT_COMMIT_HASH
ENV GIT_COMMIT_HASH=$GIT_COMMIT_HASH
ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

# Copy package definitions from base
COPY --from=base /app /app

# Install dependencies for client and shared
# We install root deps too just in case
RUN npm install
RUN cd shared && npm install
RUN cd client && npm install

# Copy source code for client and shared
COPY shared/ ./shared/
COPY client/ ./client/

# Build shared package first
RUN cd shared && npm run build

# Build client (React app)
RUN cd client && npm run build

# ----------------------------------------
# Server Build Stage
# Runs on the TARGETPLATFORM to ensure native modules (better-sqlite3)
# are built for the correct architecture.
# ----------------------------------------
FROM node:20-slim AS server-builder
WORKDIR /app
# Re-declare ARG and ENV as they don't persist across stages automatically
ARG GIT_COMMIT_HASH
ENV GIT_COMMIT_HASH=$GIT_COMMIT_HASH
ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

# Copy package definitions from base
COPY --from=base /app /app

# Install build dependencies for native modules (better-sqlite3)
RUN apt-get update && apt-get install -y python3 make g++ openssl && rm -rf /var/lib/apt/lists/*

# Install dependencies for server and shared
RUN npm install
RUN cd shared && npm install
RUN cd server && npm install

# Copy source code for server and shared
COPY shared/ ./shared/
COPY server/ ./server/

# Build shared package
RUN cd shared && npm run build

# Generate Prisma client
RUN cd server && npx prisma generate

# Build server (TypeScript -> JS)
RUN cd server && npm run build

# ----------------------------------------
# Production Stage - Frontend (nginx)
# ----------------------------------------
FROM nginx:alpine AS frontend-production

# Copy client build from client-builder
# Since output is static files, it doesn't matter that builder was different arch
COPY --from=client-builder /app/client/dist /usr/share/nginx/html

# Copy custom nginx config template
COPY docker/nginx.conf.template /etc/nginx/nginx.conf.template

# Copy entrypoint script
COPY docker/nginx-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose port
EXPOSE 80

# Start nginx
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]

# ----------------------------------------
# Production Stage - Backend (Node.js)
# ----------------------------------------
FROM node:20-slim AS backend-production

WORKDIR /app

# Install runtime dependencies for better-sqlite3 (Debian equivalent)
# libstdc++ is usually included, but openssl might be needed for Prisma
# We also upgrade installed packages to fix potential vulnerabilities (CVEs)
RUN apt-get update && apt-get upgrade -y && apt-get install -y openssl wget && rm -rf /var/lib/apt/lists/*

# Copy built server from server-builder
COPY --from=server-builder /app/server /app/server
COPY --from=server-builder /app/shared /app/shared

# Copy the backend entrypoint so the startup guards actually run in the
# published image. NOTE: the dev/CI-only docker/Dockerfile.backend already
# wires this up, but Docker Hub images are built from THIS file
# (see .github/workflows/docker-hub.yml, target: backend-production).
# Without this, the secret validation and migration steps below never
# execute and the container silently starts with generated JWT secrets.
# See #395 / #267.
COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/migrate-only.sh /migrate-only.sh
RUN chmod +x /entrypoint.sh /migrate-only.sh

# Set working directory
WORKDIR /app/server

# Create data directory
RUN mkdir -p /app/server/prisma/data

# ---------------------------------------------------------------------------
# Drop root.
#
# This container previously ran as uid 0. The live production instance was
# confirmed running as root, so any RCE in the API — or a dependency compromise
# in the Node process — held root inside the container, with full write access
# to the mounted SQLite database and every environment secret in the process.
#
# Ownership is set explicitly on the paths the process actually writes:
#   /app/server/prisma/data  the SQLite database and its WAL sidecars
#   /app/server              Prisma CLI output, migrate logs, node_modules
#   /app/shared              the shared build output read at startup
#
# The container is chowned rather than creating a user first, because the files
# arrive from the builder stages owned by root and the process needs to write
# them. The `node` image already ships a uid 1000 user named `node`, so no new
# account is added.
#
# The entrypoint still runs as root deliberately: it validates secrets and runs
# migrations, and the operator's bind-mounted volume needs a chown before the
# app can write to it. It hands off with `su-exec` at the end. The migrations
# and the server therefore run as `node`, not root.
# ---------------------------------------------------------------------------
RUN chown -R node:node /app/server /app/shared

# No privilege-drop helper is installed: `setpriv` ships with util-linux and is
# already present in node:20-slim (verified in the built image). `su-exec` is an
# Alpine package and is NOT available in Debian — attempting to install it fails
# the build outright.

# Expose port
EXPOSE 3001

# Start via the entrypoint (validates secrets, then migrates, then runs CMD)
# ENTRYPOINT stays as root so the entrypoint can chown the data volume;
# the entrypoint execs the CMD as `node`.
ENTRYPOINT ["/entrypoint.sh"]
CMD ["npm", "start"]