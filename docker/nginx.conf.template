events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    server {
        listen 80;
        server_name _;
        absolute_redirect off;
        root /usr/share/nginx/html;
        index index.html;

        # Runtime config.js - must be served directly, no caching
        location = /config.js {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
            try_files $uri =404;
        }

        # Handle client-side routing
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Service workers and the app shell must revalidate on every load.
        #
        # Both service workers are served from UNHASHED filenames, so a browser
        # that holds a stale copy keeps running the old release: the worker serves
        # its own precached shell and never sees the new one. That is not
        # hypothetical -- after an upgrade, a phone that had the site open kept
        # rendering the previous version's build string while the server was
        # already serving the new assets.
        #
        # `index.html` is the shell and names the hashed bundle, so it must never
        # be served stale either.
        #
        # These use `expires -1` (which emits `Cache-Control: no-cache`) rather
        # than `add_header Cache-Control`. In nginx a nested `add_header`
        # REPLACES the inherited set instead of adding to it, so an add_header
        # here would silently drop the CSP and HSTS headers declared below --
        # which is exactly what `location = /config.js` above already does.
        # `expires` is independent of that rule and leaves them intact.
        #
        # ponytail: explicit paths, not a `~* (sw|service-worker)\.js$` regex.
        # A regex would also match a future unhashed workbox runtime, and an
        # exact path is unambiguous to the next reader. Add a block if a new
        # unhashed worker appears.
        location = /sw.js {
            expires -1;
            try_files $uri =404;
        }

        location = /push-sw.js {
            expires -1;
            try_files $uri =404;
        }

        location = /index.html {
            expires -1;
            try_files $uri =404;
        }

        # API proxy (when backend is separate)
        location /api {
            proxy_pass http://backend:3001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Security headers
        # Security headers
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        
        # HSTS (1 year)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        
        # Content Security Policy
        # Adjusting for React (unsafe-inline is often needed for styled-components or similar if not strict)
        # connect-src allows calls to potential API endpoints
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src ${CSP_CONNECT_SOURCES};" always;
        
        # Hide Nginx version
        server_tokens off;
    }
}