# Fix npm permission issues
progress=false
loglevel=warn

# Use exact versions to avoid unexpected updates
save-exact=true

# Do NOT disable package-lock here. This repository commits five lockfiles and
# CI installs them with `npm ci`, which aborts when the manifest and lock
# disagree. With `package-lock=false` an `npm install` (including the one
# Dependabot runs) writes package.json without touching the lockfile, so every
# Dependabot PR since this line landed arrived with a stale lock and failed at
# the install step before a single test ran.

# Use cache more efficiently (prefer-offline replaces deprecated cache-min)
prefer-offline=true

# Security settings
audit-level=moderate